# DocPulse — settings for deploy/docker-compose.yml
# Copy this file to .env next to docker-compose.yml, then fill in the REQUIRED values.

# ── Required ──────────────────────────────────────────────────────
# Database password. Generate one with:  openssl rand -hex 16
POSTGRES_PASSWORD=
# Six secrets, each at least 32 characters. Generate each with:  openssl rand -hex 32
# Signs sign-in tokens.
JWT_ACCESS_SECRET=
# Asked for once, when you create the first admin account.
BOOTSTRAP_SECRET=
# Shared between the API and the background worker.
WORKER_SECRET=
NOTIFICATION_SECRET=
# Verify signed webhooks from GitHub and from your deployment tool.
GITHUB_WEBHOOK_SECRET=
DEPLOYMENT_WEBHOOK_SECRET=

# ── Addresses ─────────────────────────────────────────────────────
# Public release pages, and the admin portal on its own "admin." address.
# For a real domain, point both names at this machine (and put HTTPS in front),
# e.g. PUBLIC_URL=https://releases.example.com and
#      ADMIN_URL=https://admin.releases.example.com
PUBLIC_URL=http://localhost:8080
ADMIN_URL=http://admin.localhost:8080
# Port on this machine.
HTTP_PORT=8080
# If a reverse proxy sits in front, list its IP so visitor IPs are trusted.
TRUSTED_PROXY_IPS=

# ── Version ───────────────────────────────────────────────────────
# "latest", a release such as "1.0.0", or a build such as "sha-abc1234".
DOCPULSE_VERSION=latest

# ── Database (optional) ───────────────────────────────────────────
POSTGRES_DB=docpulse
POSTGRES_USER=docpulse

# ── Email (optional: subscriber emails and invitations) ───────────
# An HTTP email-delivery endpoint and its bearer token.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=

# ── Malware scanning (optional) ───────────────────────────────────
# Host name of a ClamAV daemon. Without it, attachment uploads are refused
# (the system fails closed rather than publishing unscanned files).
CLAMAV_HOST=
